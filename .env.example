# Copy to .env and fill in. Never commit .env.
# Neon Postgres connection string (single source of truth for the database).
NEON_CONN_URL=
# Optional extra CORS origin for the JSON API.
FRONTEND_CORS_ORIGIN=
# Bearer token required by POST /api/suggestions (cron job).
CRON_SECRET=
# Discord webhook for suggestion notifications (phase 4).
DISCORD_WEBHOOK_URL=
# Optional suggestion-engine overrides.
SUGGEST_RISK_PER_TRADE_PCT=
SUGGEST_MAX_POSITION_PCT=
SUGGEST_MIN_CONFIDENCE=
SUGGEST_LOOKBACK_DAYS=
SUGGEST_CONCURRENCY=
